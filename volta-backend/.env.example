# Volta Academy Backend – variabile de mediu
# Copiază: cp .env.example .env și completează valorile.
# Vezi și env.template pentru același conținut.

APP_NAME="Volta Academy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database (ex.: PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=volta_academy
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_SSLMODE=prefer

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# CORS – URL frontend (mai multe separate cu virgulă)
FRONTEND_URL=http://localhost:5173

# AI (ex.: Groq)
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant
AI_VERIFY_SSL=true

# Mail (opțional)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@localhost"
MAIL_FROM_NAME="${APP_NAME}"

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
