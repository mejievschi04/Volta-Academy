# Volta Academy Backend – variabile de mediu
# Copiază: cp .env.example .env și completează valorile.
# Vezi și env.template pentru același conținut.

APP_NAME="Volta Academy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Bucharest

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database (ex.: PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=volta_academy
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_SSLMODE=prefer

# Session (cookie sesiune + XSRF)
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Producție HTTPS: true (sau lasă gol — devine true automat când APP_URL e https://)
SESSION_SECURE_COOKIE=
# lax = același site (ex. SPA și API pe același host, / și /api). Cross-subdomenii diferite → uneori none + Secure
SESSION_SAME_SITE=lax
# Gol = hostul exact din browser (recomandat). Nu seta domeniu fix dacă folosești www și non-www.
SESSION_DOMAIN=

# CORS – origini frontend (virgulă). Trebuie să coincidă cu URL-ul din bară (scheme + host + port)
FRONTEND_URL=http://localhost:5173

# Sanctum SPA: hosturi fără https:// (opțional port). Hosturile din APP_URL și FRONTEND_URL se adaugă automat la listă.
# Producție explicit: academy.volta.md,www.academy.volta.md
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1

# AI (groq|openai|huggingface)
# Toate setările AI se citesc din config/ai.php (merg și după `php artisan config:cache`).
# Volt (AI) e oprit cât timp AI_ENABLED nu e true, chiar dacă există chei de API mai jos.
AI_ENABLED=false
AI_PROVIDER=groq

# Groq (dacă AI_PROVIDER=groq)
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant
GROQ_CREATOR_MODEL=llama-3.1-8b-instant
GROQ_CREATOR_QUALITY_MODEL=llama-3.3-70b-versatile
# Fallback chain: dacă modelul curent e limitat/ocupat, se încearcă pe rând următoarele.
GROQ_FALLBACK_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

# OpenAI (dacă AI_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Timeouts AI (secunde)
AI_CONNECT_TIMEOUT=15
AI_REQUEST_TIMEOUT=180
AI_TUTOR_TIMEOUT=120
# 0 = fără timeout pentru guided_creation
AI_GUIDED_CREATION_TIMEOUT=0
# Max tokens pentru generarea ghidată de curs (JSON mare: module + lecții + HTML).
# Sub ~4000 apare des JSON trunchiat / validare eșuată. 8192 e un default rezonabil pentru Groq/OpenAI.
AI_GUIDED_MAX_TOKENS=8192
# AI_ADMIN_TUTOR_MAX_TOKENS=900
# AI_BUILDER_DIFF_MAX_TOKENS=6000
# Reîncercări automate la limita de rată în crearea ghidată
# AI_GUIDED_RATE_LIMIT_RETRIES=2
# AI_GUIDED_RATE_LIMIT_MAX_BACKOFF=15
# Prag minim linii de conținut per lecție (după strip HTML). Crește dacă vrei lecții mai lungi.
AI_MIN_LESSON_LINES=11
AI_VERIFY_SSL=true

# Embedding-uri pentru căutarea lui Volt în conținut. Groq nu le oferă: fără setări aici,
# sunt active doar cu AI_PROVIDER=openai; altfel Volt caută pe cuvinte cheie.
# Furnizor propriu (ex. Ollama cu nomic-embed-text):
# AI_EMBEDDING_PROVIDER=custom
# AI_EMBEDDING_API_URL=http://localhost:11434/v1/embeddings
# AI_EMBEDDING_MODEL=nomic-embed-text
# AI_EMBEDDING_API_KEY=

# Depanare / operațiuni (implicit false)
# VOLTA_EXPOSE_API_ERRORS=false
# ALLOW_LMS_BACKUP_RESTORE=false

# Mesagerie — rate limit (după config:cache se citesc din config/messages.php)
# VOLTA_MESSAGES_READ_PER_MINUTE=2000
# VOLTA_MESSAGES_WRITE_PER_MINUTE=180

# Mail (opțional)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@localhost"
MAIL_FROM_NAME="${APP_NAME}"

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Bibliotecă — coperta primei pagini la upload vine din browser (PDF.js); nu e obligatoriu.
# Opțional pe server (regenerare CLI / fallback): Ghostscript sau Imagick.
# LIBRARY_PDF_GS="C:\Program Files\gs\gs10.04.0\bin\gswin64c.exe"
# LIBRARY_PDF_GS=
