# ===========================================
# Volta Academy - Variabile pentru Docker/VPS
# Copiază în .env și completează valorile
# ===========================================

# --- Aplicație ---
APP_NAME="Volta Academy"
APP_ENV=production
APP_KEY=base64:CHANGE_ME_GENERATE_WITH_php_artisan_key:generate
APP_DEBUG=false
APP_URL=https://academy.volta.md

# --- Database (PostgreSQL) ---
DB_PORT=5432
DB_DATABASE=volta_academy
DB_USERNAME=volta_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Porturi expuse (schimbă dacă sunt ocupate de alte servicii) ---
BACKEND_PORT=8000
FRONTEND_PORT=3001

# --- Session ---
# file = implicit în docker-compose (un singur container). database = doar dacă ai rulat migrate și tabela `sessions`.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Cache (throttle, etc.). file e suficient pe un VPS cu o instanță backend.
CACHE_STORE=file

# --- Frontend URL (pentru CORS) ---
FRONTEND_URL=https://academy.volta.md

# Temporar pe VPS dacă primești 500 fără mesaj: true → JSON la api/* include textul excepției (dezactivează după debug)
VOLTA_EXPOSE_API_ERRORS=false

# --- API URL pentru build frontend (Vite) ---
# Folosit la build: frontend-ul va apela acest URL
VITE_API_URL=https://academy.volta.md/api

# --- AI Provider (opțional: groq|openai|huggingface|ollama) ---
AI_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=
OLLAMA_API_KEY=
OLLAMA_API_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=gemma:2b-instruct
OLLAMA_CREATOR_MODEL=gemma:2b-instruct
OLLAMA_CREATOR_QUALITY_MODEL=qwen2.5:7b-instruct
OLLAMA_TUTOR_MODEL=gemma:2b-instruct
AI_TUTOR_DIRECT_STREAM=false
AI_CONNECT_TIMEOUT=15
AI_REQUEST_TIMEOUT=180
AI_TUTOR_TIMEOUT=120
AI_GUIDED_CREATION_TIMEOUT=0
AI_GUIDED_MAX_TOKENS=1100

# --- Logging ---
LOG_LEVEL=error
