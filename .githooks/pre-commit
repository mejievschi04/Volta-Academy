#!/bin/sh
# Pre-commit hook: run gitleaks to detect secrets in staged changes
# Tries local gitleaks, then Docker image. If neither available, aborts.

set -e

echo "Running secret scan (gitleaks)..."

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks detect --staged --redact || { echo "Gitleaks found secrets. Commit aborted."; exit 1; }
  echo "No secrets found by gitleaks."
  exit 0
fi

if command -v docker >/dev/null 2>&1; then
  # Mount current directory into container and run gitleaks detect on staged changes
  docker run --rm -v "$PWD":/src -w /src zricethezav/gitleaks:latest detect --staged --redact || { echo "Gitleaks (docker) found secrets. Commit aborted."; exit 1; }
  echo "No secrets found by gitleaks (docker)."
  exit 0
fi

echo "gitleaks not installed and docker not available. Install gitleaks or docker, or run 'scripts/setup-git-hooks.*' to enable hook usage." >&2
exit 1
